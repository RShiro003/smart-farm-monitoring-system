# Generate a long random value and never commit the real key.
SMART_FARM_API_KEY=replace-with-a-long-random-secret
# JSON map. Put the matching value in each board's include/secrets.h API_KEY.
SMART_FARM_DEVICE_KEYS='{"esp32_01":"replace-with-a-different-device-secret"}'
SMART_FARM_PROTECT_READS=true
DISCORD_WEBHOOK_URL=

DEVICE_OFFLINE_SECONDS=120
DEVICE_OFFLINE_CHECK_SECONDS=30
SENSOR_RAW_RETENTION_DAYS=90
SENSOR_HOURLY_RETENTION_DAYS=730
SMART_FARM_MAX_REQUEST_BYTES=65536
SMART_FARM_BEHIND_PROXY=true
SMART_FARM_LOG_LEVEL=INFO
